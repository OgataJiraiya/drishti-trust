# Example only. Generate a unique runtime value; never commit the real token.
DRISHTI_ADMIN_BEARER_TOKEN=replace-with-local-runtime-admin-token

# Compatibility ingestion remains disabled. Signed module runs need neither setting.
DRISHTI_ALLOW_UNSIGNED_INGESTION=false
DRISHTI_INTERNAL_INGEST_BEARER_TOKEN=replace-only-if-compatibility-mode-is-required

# Optional startup overrides used by scripts/run_backend.sh
DRISHTI_HOST=127.0.0.1
DRISHTI_PORT=8000

# Optional local runtime locations. If omitted, backend/data and backend/keys are used.
DRISHTI_DATA_DIR=./runtime/data
DRISHTI_KEY_DIR=./runtime/keys

# Browser runtime configuration. CORS permits loopback origins only.
VITE_DRISHTI_API_URL=http://127.0.0.1:8000
VITE_DRISHTI_DEMO_MODE=false
DRISHTI_FRONTEND_HOST=127.0.0.1
